"""
Trader_7_12 Pro

Diagnostic Service

Версия 0.2

Назначение:
- прозрачность торгового рейтинга
- вывод компонентов score
- вывод финального сигнала
"""


class DiagnosticService:


    def print_analysis(self, item):

        print()

        print("🔎 DIAGNOSTIC")

        print(
            "Ticker:",
            item.get("ticker")
        )


        print(
            "Money volume:",
            round(
                item.get("money_volume_real", 0),
                2
            )
        )


        print(
            "Volume score:",
            item.get("volume_score")
        )


        print(
            "Volume ratio:",
            item.get("volume_ratio")
        )


        print(
            "Money ratio:",
            item.get("money_ratio")
        )


        print(
            "Momentum:",
            item.get("momentum_score")
        )


        print(
            "Breakout score:",
            item.get("breakout_score")
        )


        print(
            "Trade score:",
            item.get("trade_score")
        )


        print()

        print("🚦 FINAL SIGNAL")

        print(
            "Signal:",
            item.get(
                "final_signal",
                item.get("signal")
            )
        )


        print(
            "Confidence:",
            item.get(
                "confidence",
                0
            )
        )


        reasons = item.get(
            "reasons",
            []
        )


        if reasons:

            print(
                "Reasons:"
            )

            for reason in reasons:

                print(
                    "-",
                    reason
                )
